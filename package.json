{
  "name": "dsh-refusal-guard",
  "version": "1.2.1",
  "type": "module",
  "description": "兜住「短 + 否定式开场」的短路回复并补一条执行轮；事实诊断与安全判断不补。可选搭配开关 requirePurge（默认关闭）：这是有意为之的搭配策略，不是功能依赖。",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "refusal",
    "guard"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-0"
  }
}
